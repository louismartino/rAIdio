# Copy this file to .env and fill in your values.

# LLM
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# Email
EMAIL_USER=
EMAIL_PASS=

# Telegram
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# Text-to-speech (edge-tts)
TTS_VOICE=fr-FR-DeniseNeural
TTS_RATE=+15%

# Prompt personalization
PROMPT_TEMPLATE_PATH=prompts/radio_script.fr.txt
USER_FIRST_NAME=
NEWSLETTER_ORDER="Newsletter1;Newsletter2;etc."
NEWSLETTER_LIMIT_NAME="Newsletter too long"
NEWSLETTER_LIMIT_COUNT=

# FastAPI
FASTAPI_API_KEY=
